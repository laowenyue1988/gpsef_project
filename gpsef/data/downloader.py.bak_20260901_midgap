# -*- coding: utf-8 -*-
"""
独立数据下载模块
支持增量下载原始日线、后复权因子、股票列表、分钟K线（串行，超时自动跳过）

融合版：保留智能跳过 + 详细日志 + v3连接稳定性改进 + 向量化时间解析
"""

import os, sys, time, logging, glob, socket, concurrent.futures, gc
from datetime import datetime, timedelta
from typing import Optional, List, Tuple, Dict
import pandas as pd
import numpy as np

try:
    import baostock as bs
except ImportError:
    raise ImportError("baostock未安装，请执行: pip install baostock")

logger = logging.getLogger(__name__)

VALID_STOCK_PREFIXES = (
    'sh.600', 'sh.601', 'sh.603', 'sh.605', 'sh.688', 'sh.689',
    'sz.000', 'sz.001', 'sz.002', 'sz.003', 'sz.300', 'sz.301', 'sz.302'
)

MINUTE_FREQ_MAP = {'5': '5min', '15': '15min', '30': '30min', '60': '60min'}
SUPPORTED_MINUTE_FREQ = ['5', '15', '30', '60']

# 需要触发强制重连的错误关键词/错误码
RECONNECT_ERROR_PATTERNS = [
    'timeout', 'socket', '10054', '10002007', '网络接收错误',
    '连接', 'reset', 'broken pipe', 'connection',
]


def _is_reconnect_needed(error_msg: str) -> bool:
    """判断错误是否需要强制重连"""
    if not error_msg:
        return False
    err_lower = error_msg.lower()
    return any(p in err_lower for p in RECONNECT_ERROR_PATTERNS)


# ======================== 向量化时间解析 ========================

def _parse_minute_time_vectorized(dates: pd.Series, times: pd.Series) -> Tuple[pd.Series, pd.Series]:
    """向量化解析分钟线时间，比逐行 iterrows 快 50-100 倍。"""
    dates_str = dates.astype(str).str.strip()
    times_str = times.astype(str).str.strip()

    has_dash = dates_str.str.contains('-')
    years = pd.Series(np.int32(0), index=dates.index)
    months = pd.Series(np.int32(0), index=dates.index)
    days = pd.Series(np.int32(0), index=dates.index)

    if has_dash.any():
        parts = dates_str[has_dash].str.split('-', expand=True)
        years[has_dash] = parts[0].astype(np.int32)
        months[has_dash] = parts[1].astype(np.int32)
        days[has_dash] = parts[2].astype(np.int32)

    no_dash = ~has_dash
    if no_dash.any():
        d = dates_str[no_dash]
        years[no_dash] = d.str[:4].astype(np.int32)
        months[no_dash] = d.str[4:6].astype(np.int32)
        days[no_dash] = d.str[6:8].astype(np.int32)

    hours = pd.Series(np.int32(0), index=times.index)
    mins = pd.Series(np.int32(0), index=times.index)
    secs = pd.Series(np.int32(0), index=times.index)

    t = times_str
    t_len = t.str.len()

    mask14 = t_len >= 14
    if mask14.any():
        t14 = t[mask14]
        hours[mask14] = t14.str[8:10].astype(np.int32)
        mins[mask14] = t14.str[10:12].astype(np.int32)
        secs[mask14] = t14.str[12:14].astype(np.int32)

    mask6 = (~mask14) & (t_len >= 5)
    if mask6.any():
        t6 = t[mask6]
        hours[mask6] = t6.str[:2].astype(np.int32)
        mins[mask6] = t6.str[2:4].astype(np.int32)
        secs[mask6] = t6.str[4:6].astype(np.int32)

    mask_short = (~mask14) & (~mask6)
    if mask_short.any():
        t_s = t[mask_short].astype(np.int64)
        hours[mask_short] = (t_s // 100).astype(np.int32)
        mins[mask_short] = (t_s % 100).astype(np.int32)

    try:
        trade_time = pd.to_datetime(
            pd.DataFrame({
                'year': years, 'month': months, 'day': days,
                'hour': hours, 'minute': mins, 'second': secs
            })
        )
    except Exception:
        trade_time = pd.NaT
        logger.warning("向量化时间解析失败，返回 NaT")

    trade_date = trade_time.dt.normalize() if hasattr(trade_time, 'dt') else pd.NaT
    return trade_time, trade_date


# ======================== BaostockSession ========================

class BaostockSession:
    """
    baostock 连接管理单例。
    核心策略：每次错误后彻底杀掉旧连接，重新 login 拿到新 socket。
    """
    _instance = None
    _logged_in = False
    _last_activity = None
    _socket_timeout = 30
    _reconnect_interval = 50
    _operation_count = 0
    _consecutive_errors = 0
    _max_consecutive_errors = 3

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance

    def _kill_connection(self):
        """彻底杀掉 baostock 内部连接"""
        logger.debug("[BaoStock] 清理旧连接...")
        try:
            bs.logout()
        except:
            pass
        try:
            if hasattr(bs, 'context') and bs.context is not None:
                ctx = bs.context
                if hasattr(ctx, '_BsContext__api'):
                    api = ctx._BsContext__api
                    if hasattr(api, '_socket') and api._socket is not None:
                        try:
                            api._socket.shutdown(socket.SHUT_RDWR)
                        except:
                            pass
                        try:
                            api._socket.close()
                        except:
                            pass
                        api._socket = None
                if hasattr(ctx, '_BsContext__is_connected'):
                    ctx._BsContext__is_connected = False
        except Exception as e:
            logger.debug(f"[BaoStock] 清理socket异常(可忽略): {e}")
        gc.collect()
        self._logged_in = False
        time.sleep(0.5)

    def login(self, force=False):
        if not self._logged_in or force:
            if self._logged_in and force:
                self._kill_connection()
            self._logged_in = False
            socket.setdefaulttimeout(self._socket_timeout)
            logger.info(f"[BaoStock] 登录中... (socket_timeout={self._socket_timeout}s)")
            max_login_retries = 3
            for login_attempt in range(max_login_retries):
                try:
                    lg = bs.login()
                    if lg.error_code == '0':
                        self._logged_in = True
                        self._last_activity = time.time()
                        self._operation_count = 0
                        self._consecutive_errors = 0
                        logger.info("[BaoStock] 登录成功")
                        return True
                    else:
                        logger.warning(f"[BaoStock] 登录返回错误: {lg.error_code} {lg.error_msg}")
                except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
                    logger.warning(f"[BaoStock] 登录网络异常: {e}")
                except Exception as e:
                    logger.warning(f"[BaoStock] 登录异常: {e}")
                self._kill_connection()
                wait = 3 * (login_attempt + 1)
                logger.info(f"[BaoStock] 登录失败，{wait}s 后重试 ({login_attempt + 1}/{max_login_retries})")
                time.sleep(wait)
            raise ValueError(f"[BaoStock] 登录失败，已重试 {max_login_retries} 次")
        return True

    def logout(self):
        try:
            bs.logout()
        except:
            pass
        self._logged_in = False

    def ensure_logged_in(self):
        if not self._logged_in:
            self.login()
            return
        now = time.time()
        if self._last_activity and (now - self._last_activity) > 300:
            try:
                rs = bs.query_stock_basic(code="sh.600000")
                if rs is None or rs.error_code != '0':
                    logger.warning("[BaoStock] 连接检测失败，正在重连...")
                    self.login(force=True)
            except Exception:
                logger.warning("[BaoStock] 连接检测异常，正在重连...")
                self.login(force=True)
        self._last_activity = now

    def update_activity(self):
        self._last_activity = time.time()
        self._operation_count += 1
        if self._operation_count >= self._reconnect_interval:
            logger.info(f"[BaoStock] 已执行 {self._operation_count} 次操作，主动重连刷新连接")
            self.login(force=True)

    def report_error(self, error_msg: str):
        self._consecutive_errors += 1
        if _is_reconnect_needed(error_msg):
            logger.warning(f"[BaoStock] 网络错误 (连续第 {self._consecutive_errors} 次): {error_msg}")
            self.login(force=True)
        else:
            logger.debug(f"[BaoStock] 非网络错误 (连续第 {self._consecutive_errors} 次): {error_msg}")
        if self._consecutive_errors >= self._max_consecutive_errors:
            cool_down = min(60, 10 * (2 ** (self._consecutive_errors - self._max_consecutive_errors)))
            logger.warning(f"[BaoStock] 连续 {self._consecutive_errors} 次错误，全局冷却 {cool_down}s...")
            time.sleep(cool_down)
            self.login(force=True)
            return 3
        else:
            backoff = min(30, 3 * (2 ** (self._consecutive_errors - 1)))
            return backoff

    def report_success(self):
        self._consecutive_errors = 0


_session = BaostockSession()


def get_baostock_session():
    return _session


# ======================== DataDownloader ========================

class DataDownloader:
    """数据下载器"""

    def __init__(self, base_path):
        self.base_path = base_path
        self.raw_daily_path = os.path.join(base_path, 'raw_daily')
        self.back_adjust_path = os.path.join(base_path, 'back_adjust_factors')
        self.stock_list_path = os.path.join(base_path, 'stock_list')
        self.trade_calendar_path = os.path.join(base_path, 'trade_datas.csv')
        self.range_cache_path = os.path.join(base_path, 'stock_date_range.parquet')
        self.raw_minute_base_path = os.path.join(base_path, 'raw_minute')
        self.minute_range_cache_path = os.path.join(base_path, 'stock_date_range_minute.parquet')
        self.dividend_data_path = os.path.join(base_path, 'dividend_data')

        os.makedirs(self.raw_daily_path, exist_ok=True)
        os.makedirs(self.back_adjust_path, exist_ok=True)
        os.makedirs(self.stock_list_path, exist_ok=True)
        os.makedirs(self.dividend_data_path, exist_ok=True)

        self._range_cache = None
        self._load_range_cache()
        self._minute_range_cache = {}
        self._load_minute_range_cache()

    # ==================== 日线缓存管理 ====================
    def _load_range_cache(self):
        if os.path.exists(self.range_cache_path):
            try:
                self._range_cache = pd.read_parquet(self.range_cache_path)
                logger.info(f"加载日期范围缓存: {len(self._range_cache)}条")
            except:
                self._range_cache = pd.DataFrame(columns=['code', 'min_date', 'max_date'])
        else:
            self._range_cache = pd.DataFrame(columns=['code', 'min_date', 'max_date'])

    def _save_range_cache(self):
        if self._range_cache is not None:
            self._range_cache.to_parquet(self.range_cache_path, index=False)

    def _update_range_cache(self, code, min_date, max_date):
        mask = self._range_cache['code'] == code
        if mask.any():
            old_min = self._range_cache.loc[mask, 'min_date'].iloc[0]
            old_max = self._range_cache.loc[mask, 'max_date'].iloc[0]
            new_min = min(old_min, min_date)
            new_max = max(old_max, max_date)
            self._range_cache.loc[mask, 'min_date'] = new_min
            self._range_cache.loc[mask, 'max_date'] = new_max
        else:
            new_row = pd.DataFrame([[code, min_date, max_date]], columns=['code', 'min_date', 'max_date'])
            self._range_cache = pd.concat([self._range_cache, new_row], ignore_index=True)
        self._save_range_cache()

    def get_stock_date_range(self, code):
        if self._range_cache is None or self._range_cache.empty:
            return None, None
        row = self._range_cache[self._range_cache['code'] == code]
        return (None, None) if row.empty else (row.iloc[0]['min_date'], row.iloc[0]['max_date'])

    # ==================== 分钟线缓存管理 ====================
    def _load_minute_range_cache(self):
        if os.path.exists(self.minute_range_cache_path):
            try:
                df = pd.read_parquet(self.minute_range_cache_path)
                # 如果 code 在索引中，重置为列
                if 'code' not in df.columns and (df.index.name == 'code' or 'code' in df.index.names):
                    df = df.reset_index()

                if df.empty or 'code' not in df.columns:
                    logger.info("分钟线日期范围缓存为空或无 code 列，初始化空缓存")
                    self._minute_range_cache = {freq: pd.DataFrame() for freq in SUPPORTED_MINUTE_FREQ}
                    return

                for freq in SUPPORTED_MINUTE_FREQ:
                    min_col, max_col = f'min_date_{freq}', f'max_date_{freq}'
                    if min_col in df.columns and max_col in df.columns:
                        mask = df[min_col].notna() | df[max_col].notna()
                        freq_df = df.loc[mask, ['code', min_col, max_col]].copy()
                        if not freq_df.empty:
                            self._minute_range_cache[freq] = freq_df.set_index('code')
                            logger.info(f"加载 {freq}分钟线缓存: {len(freq_df)} 只股票")
                        else:
                            self._minute_range_cache[freq] = pd.DataFrame()
                    else:
                        self._minute_range_cache[freq] = pd.DataFrame()
            except Exception as e:
                logger.warning(f"加载分钟线缓存失败: {e}")
                self._minute_range_cache = {freq: pd.DataFrame() for freq in SUPPORTED_MINUTE_FREQ}
        else:
            logger.info("分钟线日期范围缓存文件不存在，初始化空缓存")
            self._minute_range_cache = {freq: pd.DataFrame() for freq in SUPPORTED_MINUTE_FREQ}

    def _save_minute_range_cache(self):
        if not self._minute_range_cache:
            return
        dfs = []
        for freq in SUPPORTED_MINUTE_FREQ:
            df = self._minute_range_cache.get(freq)
            if df is not None and not df.empty:
                df = df.reset_index()
                dfs.append(df)
        if dfs:
            combined = dfs[0]
            for df in dfs[1:]:
                combined = combined.merge(df, on='code', how='outer')
            if 'code' in combined.columns:
                combined.to_parquet(self.minute_range_cache_path, index=False)
                logger.debug(f"分钟线日期范围缓存已保存: {len(combined)} 条")

    def _get_minute_date_range(self, code, freq):
        cache = self._minute_range_cache.get(freq)
        if cache is None or cache.empty:
            return None, None
        if code not in cache.index:
            return None, None
        try:
            row = cache.loc[code]
            if isinstance(row, pd.DataFrame):
                row = row.iloc[0]
            min_date = row.get(f'min_date_{freq}')
            max_date = row.get(f'max_date_{freq}')
            if pd.notna(min_date):
                min_date = str(min_date)
            else:
                min_date = None
            if pd.notna(max_date):
                max_date = str(max_date)
            else:
                max_date = None
            return min_date, max_date
        except Exception as e:
            logger.debug(f"查询 {code} 的 {freq} 分钟线缓存失败: {e}")
            return None, None

    def _update_minute_range_cache(self, code, freq, min_date, max_date):
        if freq not in self._minute_range_cache:
            self._minute_range_cache[freq] = pd.DataFrame()
        cache = self._minute_range_cache[freq]
        if cache.empty:
            self._minute_range_cache[freq] = pd.DataFrame(
                columns=[f'min_date_{freq}', f'max_date_{freq}'],
                index=pd.Index([], name='code')
            )
            cache = self._minute_range_cache[freq]

        min_col, max_col = f'min_date_{freq}', f'max_date_{freq}'
        if code in cache.index:
            old_min = cache.loc[code, min_col]
            old_max = cache.loc[code, max_col]
            new_min = str(min(old_min, min_date)) if pd.notna(old_min) else min_date
            new_max = str(max(old_max, max_date)) if pd.notna(old_max) else max_date
            cache.loc[code, min_col] = new_min
            cache.loc[code, max_col] = new_max
        else:
            cache.loc[code] = [min_date, max_date]
        self._save_minute_range_cache()
        logger.debug(f"更新 {code} {freq}分钟线缓存: {min_date} ~ {max_date}")

    def _get_raw_minute_path(self, code, freq):
        safe = code.replace('.', '_')
        freq_dir = MINUTE_FREQ_MAP.get(freq, f'{freq}min')
        freq_path = os.path.join(self.raw_minute_base_path, freq_dir)
        os.makedirs(freq_path, exist_ok=True)
        return os.path.join(freq_path, f"{safe}.parquet")

    # ==================== 分钟线下载（v3 连接稳定性） ====================

    def _download_minute_segment(self, code, freq, start, end, timeout=120):
        """
        下载单段分钟K线，带超时保护。
        使用 ThreadPoolExecutor 防止 baostock 底层 TCP 永久阻塞。
        """

        def _download():
            session = get_baostock_session()
            session.ensure_logged_in()

            start_fmt = start if '-' in start else f"{start[:4]}-{start[4:6]}-{start[6:]}"
            end_fmt = end if '-' in end else f"{end[:4]}-{end[4:6]}-{end[6:]}"

            minute_fields = "date,time,code,open,high,low,close,volume,amount,adjustflag"

            logger.debug(f"  [BaoStock] query({code}, {start_fmt}~{end_fmt}, freq={freq})")

            try:
                rs = bs.query_history_k_data_plus(
                    code, minute_fields,
                    start_date=start_fmt, end_date=end_fmt,
                    frequency=freq, adjustflag="3"
                )
            except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
                return None, f"socket_error_on_query: {type(e).__name__} {e}"
            except Exception as e:
                return None, f"query_exception: {type(e).__name__} {e}"

            # 保持原有逻辑：error_code != 0 返回普通错误消息，可被 retry 识别为网络错误
            if rs.error_code != '0':
                err_msg = f"baostock_error: {rs.error_code} {rs.error_msg}"
                logger.debug(f"  [BaoStock] {code} query返回错误: {err_msg}")
                return None, err_msg

            data_list = []
            try:
                while (rs.error_code == '0') & rs.next():
                    data_list.append(rs.get_row_data())
            except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
                if data_list:
                    logger.warning(f"  [{code}] 读取行时socket异常，已获取 {len(data_list)} 行，返回部分数据")
                else:
                    return None, f"socket_error_on_read: {type(e).__name__} {e}"
            except Exception as e:
                if data_list:
                    logger.warning(f"  [{code}] 读取行时异常，已获取 {len(data_list)} 行，返回部分数据")
                else:
                    return None, f"read_exception: {type(e).__name__} {e}"

            # ========== 修改：无数据标记为不可重试（退市/停牌） ==========
            if not data_list:
                return None, "__EMPTY__"

            logger.debug(f"  [BaoStock] {code} {start_fmt}~{end_fmt} 获取 {len(data_list)} 行")

            df = pd.DataFrame(data_list,
                              columns=["date", "time", "code", "open", "high", "low", "close", "volume", "amount",
                                       "adjustflag"])
            for col in ['open', 'high', 'low', 'close', 'volume', 'amount']:
                df[col] = pd.to_numeric(df[col], errors='coerce')

            # 向量化时间解析
            trade_time, trade_date = _parse_minute_time_vectorized(df['date'], df['time'])
            df['trade_time'] = trade_time
            df['trade_date'] = trade_date
            df['ts_code'] = code

            df = df.dropna(subset=['trade_time'])
            # ========== 修改：解析后为空同样不可重试 ==========
            if df.empty:
                return None, "__EMPTY__"

            return df[['trade_time', 'trade_date', 'ts_code', 'open', 'high', 'low', 'close', 'volume', 'amount']], None

        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
            future = executor.submit(_download)
            try:
                return future.result(timeout=timeout)
            except concurrent.futures.TimeoutError:
                logger.warning(f"  [{code}] 分段下载超时 ({timeout}s)")
                return None, "timeout"
            except Exception as e:
                return None, f"executor_exception: {type(e).__name__} {e}"

    def _download_minute_with_retry(self, code, freq, start, end, max_retries=5, timeout=120):
        """
        带重试+重连的分钟线下载。

        不可重试的错误：
        - __EMPTY__：退市/停牌导致的无数据，直接返回不重试
        """
        session = get_baostock_session()

        for attempt in range(max_retries):
            df, err = self._download_minute_segment(code, freq, start, end, timeout=timeout)
            if err is None:
                session.report_success()
                return df, None

            # ========== 新增：无数据直接返回，不重试 ==========
            if err == "__EMPTY__":
                logger.debug(f"  [{code}] {start}~{end} 无数据（退市/停牌），跳过")
                return None, "__EMPTY__"

            wait_time = session.report_error(err)
            logger.warning(
                f"  [{code}] 第 {attempt + 1}/{max_retries} 次失败: {err}，"
                f"等待 {wait_time:.0f}s 后重试"
            )
            time.sleep(wait_time)

        return None, f"failed_after_{max_retries}_retries"

    def save_raw_minute(self, code, freq, df):
        """保存原始分钟线数据，支持增量合并"""
        file_path = self._get_raw_minute_path(code, freq)
        df['trade_time'] = pd.to_datetime(df['trade_time'])
        df['trade_date'] = pd.to_datetime(df['trade_date'])

        if os.path.exists(file_path):
            existing = pd.read_parquet(file_path)
            existing['trade_time'] = pd.to_datetime(existing['trade_time'])
            existing['trade_date'] = pd.to_datetime(existing['trade_date'])
            combined = pd.concat([existing, df], ignore_index=True)
            combined = combined.drop_duplicates(subset=['trade_time'], keep='last')
            df = combined.sort_values('trade_time').reset_index(drop=True)

        df.to_parquet(file_path, index=False, compression='snappy')

        if not df.empty:
            min_date = df['trade_date'].min().strftime('%Y%m%d')
            max_date = df['trade_date'].max().strftime('%Y%m%d')
            self._update_minute_range_cache(code, freq, min_date, max_date)

    def update_all_raw_minute(
            self,
            freq: str,
            target_start_date: str = None,
            target_end_date: str = None,
            stock_codes: Optional[List[str]] = None
    ):
        """
        增量更新所有股票的原始分钟线

        智能下载策略：
        - 不指定 target_start_date：从缓存末尾继续增量下载（首次则从2020-01-01开始）
        - 指定 target_start_date：对比缓存范围，只下载缓存未覆盖的部分（增量追加）
        """
        if target_end_date is None:
            target_end_date = datetime.now().strftime('%Y-%m-%d')
        else:
            if len(target_end_date) == 8:
                target_end_date = f"{target_end_date[:4]}-{target_end_date[4:6]}-{target_end_date[6:]}"

        user_specified_start = target_start_date is not None
        if user_specified_start:
            if len(target_start_date) == 8:
                target_start_date = f"{target_start_date[:4]}-{target_start_date[4:6]}-{target_start_date[6:]}"
            target_start_dt = datetime.strptime(target_start_date, '%Y-%m-%d')
        else:
            target_start_dt = None

        freq_name = MINUTE_FREQ_MAP.get(freq, f'{freq}min')

        logger.info("=" * 60)
        logger.info(f"开始增量更新{freq_name}线")

        for f in SUPPORTED_MINUTE_FREQ:
            cache = self._minute_range_cache.get(f, pd.DataFrame())
            logger.info(f"{f}分钟线缓存: {len(cache)} 只股票")

        if user_specified_start:
            logger.info(f"指定日期范围: {target_start_date} ~ {target_end_date}")
            logger.info(f"智能下载：仅下载缓存未覆盖的部分")
        else:
            logger.info(f"自动模式：从缓存末尾继续增量下载")
            logger.info(f"目标结束日期: {target_end_date}")
        logger.info("=" * 60)

        if stock_codes is None:
            logger.info("正在加载股票列表...")
            stock_df = self.download_stock_list()
            stock_codes = stock_df['code'].tolist()

        total = len(stock_codes)
        logger.info(f"共有 {total} 只股票需要检查")
        logger.info("=" * 60)

        target_end_dt = datetime.strptime(target_end_date, '%Y-%m-%d')
        success_count = 0
        skip_count = 0
        empty_count = 0  # 退市/停牌无数据
        fail_count = 0
        failed_codes = []
        start_time = time.time()

        # 分钟线分段大小：30天
        MAX_SEGMENT_DAYS = 30

        # 初始登录
        get_baostock_session().login()

        for i, code in enumerate(stock_codes):
            current_num = i + 1
            elapsed = time.time() - start_time

            cached_min, cached_max = self._get_minute_date_range(code, freq)
            cached_min_dt = datetime.strptime(cached_min, '%Y%m%d') if cached_min else None
            cached_max_dt = datetime.strptime(cached_max, '%Y%m%d') if cached_max else None

            # 计算需要下载的时间间隙
            gaps = []  # list of (start_dt, end_dt) datetime pairs
            gap_strs = []  # list of (start_str, end_str) for logging

            if user_specified_start:
                if cached_min_dt is None:
                    # 无缓存，整个区间都需要下载
                    gaps.append((target_start_dt, target_end_dt))
                    gap_strs.append((target_start_date, target_end_date))
                else:
                    # 前段间隙: [D1, min(D3-1, D2)]
                    if cached_min_dt > target_start_dt:
                        head_end_dt = min(cached_min_dt - timedelta(days=1), target_end_dt)
                        if head_end_dt >= target_start_dt:
                            gaps.append((target_start_dt, head_end_dt))
                            gap_strs.append((target_start_date, head_end_dt.strftime('%Y-%m-%d')))
                    # 后段间隙: [max(D4+1, D1), D2]
                    if cached_max_dt is not None and cached_max_dt < target_end_dt:
                        tail_start_dt = max(cached_max_dt + timedelta(days=1), target_start_dt)
                        if tail_start_dt <= target_end_dt:
                            gaps.append((tail_start_dt, target_end_dt))
                            gap_strs.append((tail_start_dt.strftime('%Y-%m-%d'), target_end_date))
            else:
                # 自动模式：仅补尾部（保持原逻辑）
                if cached_max_dt is not None:
                    if cached_max_dt >= target_end_dt:
                        skip_count += 1
                        avg_time = elapsed / current_num if current_num > 0 else 0
                        remaining = avg_time * (total - current_num)
                        logger.info(f"[{current_num}/{total}] {code} : 缓存已覆盖, 跳过 | "
                                    f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                                    f"预计剩余:{remaining / 60:.1f}分")
                        continue
                    tail_start_dt = cached_max_dt + timedelta(days=1)
                    if tail_start_dt <= target_end_dt:
                        gaps.append((tail_start_dt, target_end_dt))
                        gap_strs.append((tail_start_dt.strftime('%Y-%m-%d'), target_end_date))
                else:
                    # baostock分钟线最早数据：2020-01-03
                    default_minute_start = datetime(2020, 1, 3)
                    gaps.append((default_minute_start, target_end_dt))
                    gap_strs.append(('2020-01-03', target_end_date))

            if not gaps:
                skip_count += 1
                avg_time = elapsed / current_num if current_num > 0 else 0
                remaining = avg_time * (total - current_num)
                logger.info(f"[{current_num}/{total}] {code} : 缓存已覆盖, 跳过 | "
                            f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                            f"预计剩余:{remaining / 60:.1f}分")
                continue

            # 从所有间隙生成下载分段（每段30天）
            gap_desc = ', '.join(f"{s}~{e}" for s, e in gap_strs)
            segments = []
            for gap_s_dt, gap_e_dt in gaps:
                seg_start_dt = gap_s_dt
                while seg_start_dt < gap_e_dt:
                    seg_end_dt = min(seg_start_dt + timedelta(days=MAX_SEGMENT_DAYS), gap_e_dt)
                    segments.append((
                        seg_start_dt.strftime('%Y-%m-%d'),
                        seg_end_dt.strftime('%Y-%m-%d')
                    ))
                    seg_start_dt = seg_end_dt + timedelta(days=1)

            df_all = []
            stock_success = True
            stock_empty = False  # 退市/停牌标记
            seg_fail_reason = None
            consecutive_empty = 0  # 连续空分段计数
            MAX_CONSECUTIVE_EMPTY = 3  # 连续3段空则跳过当前gap剩余分段

            for seg_idx, (seg_start, seg_end) in enumerate(segments):
                df_seg, err = self._download_minute_with_retry(
                    code, freq, seg_start, seg_end,
                    max_retries=5, timeout=120
                )

                if err == "__EMPTY__":
                    consecutive_empty += 1
                    if consecutive_empty >= MAX_CONSECUTIVE_EMPTY:
                        # 连续多段无数据，跳过当前gap剩余分段
                        # baostock分钟线数据最早2020-01-03，早于此日期的分段返回空
                        logger.debug(f"  [{code}] 连续 {consecutive_empty} 段无数据，跳过剩余分段")
                        break
                    # 未达连续阈值，继续下一段
                    continue

                if err is not None:
                    logger.warning(f"  [{code}] 分段 {seg_start}~{seg_end} 最终失败: {err}")
                    stock_success = False
                    seg_fail_reason = err
                    break

                # 有数据，重置连续空计数
                consecutive_empty = 0

                if df_seg is not None and not df_seg.empty:
                    df_all.append(df_seg)

                time.sleep(0.3)

            # 所有分段处理完毕后，判断是否有数据
            if not df_all and stock_success and consecutive_empty > 0:
                stock_empty = True

            # 保存结果 - 单行日志
            avg_time = elapsed / current_num if current_num > 0 else 0
            remaining = avg_time * (total - current_num)

            if stock_empty:
                # 退市/停牌导致无数据，不计入失败
                empty_count += 1
                logger.info(f"[{current_num}/{total}] {code} : 无数据(退市/停牌), 跳过 | "
                            f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                            f"预计剩余:{remaining / 60:.1f}分")
            elif df_all and stock_success:
                df_combined = pd.concat(df_all, ignore_index=True)
                total_rows = len(df_combined)
                self.save_raw_minute(code, freq, df_combined)
                success_count += 1
                logger.info(f"[{current_num}/{total}] {code} : 下载 {gap_desc}, "
                            f"成功:{total_rows}条 | "
                            f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                            f"预计剩余:{remaining / 60:.1f}分")
            elif df_all and not stock_success:
                df_combined = pd.concat(df_all, ignore_index=True)
                self.save_raw_minute(code, freq, df_combined)
                fail_count += 1
                failed_codes.append((code, f"partial_fail: {seg_fail_reason}"))
                logger.warning(f"[{current_num}/{total}] {code} : 下载 {gap_desc}, "
                               f"部分成功({len(df_combined)}条) | "
                               f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                               f"预计剩余:{remaining / 60:.1f}分")
            else:
                fail_count += 1
                failed_codes.append((code, seg_fail_reason or "no_data"))
                logger.warning(f"[{current_num}/{total}] {code} : 下载 {gap_desc}, "
                               f"失败:无数据 | "
                               f"成功:{success_count} 跳过:{skip_count+empty_count} 失败:{fail_count} | "
                               f"预计剩余:{remaining / 60:.1f}分")

            time.sleep(0.5)

        elapsed = time.time() - start_time
        logger.info("=" * 60)
        logger.info(f"{freq_name}线更新完成！")
        logger.info(f"总计: {total} 只")
        logger.info(f"成功(新增数据): {success_count} 只")
        logger.info(f"跳过(缓存已覆盖): {skip_count} 只")
        logger.info(f"无数据(退市/停牌): {empty_count} 只")
        logger.info(f"失败: {fail_count} 只")
        if user_specified_start:
            logger.info(f"指定日期范围: {target_start_date} ~ {target_end_date}")
        logger.info(f"总耗时: {elapsed / 60:.1f} 分钟 ({elapsed / 3600:.1f} 小时)")
        if total > 0:
            logger.info(f"平均每只: {elapsed / total:.1f} 秒")

        if failed_codes:
            logger.info(f"失败股票列表 ({len(failed_codes)} 只):")
            for fc_code, fc_reason in failed_codes[:50]:
                logger.info(f"  {fc_code}: {fc_reason}")
            if len(failed_codes) > 50:
                logger.info(f"  ... 还有 {len(failed_codes) - 50} 只，详见日志")
        logger.info("=" * 60)

    # ==================== 日线相关方法 ====================
    def download_trade_calendar(self, start_date='2018-01-01', end_date=None):
        if end_date is None:
            end_date = (datetime.now() + timedelta(days=365)).strftime('%Y-%m-%d')
        session = get_baostock_session()
        session.ensure_logged_in()
        logger.info(f"下载交易日历: {start_date} 至 {end_date}")
        try:
            rs = bs.query_trade_dates(start_date=start_date, end_date=end_date)
        except (socket.timeout, OSError) as e:
            logger.warning(f"下载交易日历网络异常: {e}，重连后重试")
            session.login(force=True)
            rs = bs.query_trade_dates(start_date=start_date, end_date=end_date)
        if rs.error_code != '0':
            raise ValueError(f"获取交易日历失败: {rs.error_msg}")
        data_list = []
        while (rs.error_code == '0') & rs.next():
            data_list.append(rs.get_row_data())
        df = pd.DataFrame(data_list, columns=rs.fields)
        df['calendar_date'] = pd.to_datetime(df['calendar_date'])
        df['is_trading_day'] = pd.to_numeric(df['is_trading_day'])
        df.to_csv(self.trade_calendar_path, index=False, encoding='utf-8-sig')
        logger.info(f"交易日历已保存: {len(df)}条")
        return df

    def download_stock_list(self, force_update=False):
        stock_list_file = os.path.join(self.stock_list_path, 'historical_stocks.parquet')
        if os.path.exists(stock_list_file) and not force_update:
            df = pd.read_parquet(stock_list_file)
            logger.info(f"从本地加载股票列表: {len(df)}只")
            return df

        logger.info("从Baostock获取完整历史股票列表...")
        session = get_baostock_session()
        session.ensure_logged_in()

        cal_df = self.download_trade_calendar()
        cal_df = cal_df[cal_df['calendar_date'] >= '2010-01-01']
        cal_df['year_quarter'] = cal_df['calendar_date'].dt.to_period('Q')
        first_days = cal_df.groupby('year_quarter')['calendar_date'].first().tolist()
        query_dates = sorted(first_days)

        all_codes = {}
        for query_date in query_dates:
            date_str = query_date.strftime('%Y-%m-%d')
            try:
                rs = bs.query_all_stock(day=date_str)
                if rs.error_code != '0':
                    continue
                while (rs.error_code == '0') & rs.next():
                    row = rs.get_row_data()
                    code = row[0].lower()
                    name = row[1]
                    all_codes[code] = name
            except Exception as e:
                logger.warning(f"查询 {date_str} 异常: {e}")
            time.sleep(0.1)

        if not all_codes:
            raise ValueError("未能获取任何历史股票数据")

        result = pd.DataFrame(list(all_codes.items()), columns=['code', 'code_name'])
        result = result[result['code'].str.startswith(VALID_STOCK_PREFIXES)]
        result.to_parquet(stock_list_file, index=False)
        logger.info(f"历史股票列表已保存: {len(result)}只")
        return result

    def download_raw_daily(self, code, start_date, end_date, max_retries=3):
        session = get_baostock_session()
        start_fmt = start_date if '-' in start_date else f"{start_date[:4]}-{start_date[4:6]}-{start_date[6:]}"
        end_fmt = end_date if '-' in end_date else f"{end_date[:4]}-{end_date[4:6]}-{end_date[6:]}"
        raw_fields = "date,code,open,high,low,close,preclose,volume,amount,turn,tradestatus,pctChg,isST"

        for attempt in range(max_retries):
            try:
                session.ensure_logged_in()
                rs = bs.query_history_k_data_plus(
                    code, raw_fields,
                    start_date=start_fmt, end_date=end_fmt,
                    frequency="d", adjustflag="3"
                )
                if rs.error_code != '0':
                    logger.warning(f"下载 [{code}] 错误: {rs.error_msg} (尝试 {attempt + 1}/{max_retries})")
                    if _is_reconnect_needed(f"{rs.error_code} {rs.error_msg}"):
                        session.report_error(f"{rs.error_code} {rs.error_msg}")
                    time.sleep(2 ** attempt)
                    continue
                data_list = []
                while (rs.error_code == '0') & rs.next():
                    data_list.append(rs.get_row_data())
                if not data_list:
                    logger.debug(f"下载 [{code}] 返回空数据 (尝试 {attempt + 1}/{max_retries})")
                    time.sleep(2 ** attempt)
                    continue
                df_raw = pd.DataFrame(data_list, columns=rs.fields)
                numeric_cols = ['open', 'high', 'low', 'close', 'preclose', 'volume', 'amount', 'turn', 'pctChg']
                for col in numeric_cols:
                    if col in df_raw.columns:
                        df_raw[col] = pd.to_numeric(df_raw[col], errors='coerce')
                df_raw['trade_date'] = pd.to_datetime(df_raw['date'])
                df_raw['ts_code'] = code
                session.update_activity()
                session.report_success()
                return df_raw
            except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
                logger.warning(f"下载 [{code}] socket异常 (尝试 {attempt + 1}/{max_retries}): {e}")
                session.report_error(f"socket: {e}")
                time.sleep(2 ** attempt)
            except Exception as e:
                logger.warning(f"下载 [{code}] 异常 (尝试 {attempt + 1}/{max_retries}): {e}")
                time.sleep(2 ** attempt)

        logger.error(f"下载 [{code}] 失败，已重试 {max_retries} 次")
        return None

    def download_back_adjust(self, code, start_date='1990-01-01', end_date=None):
        if end_date is None:
            end_date = datetime.now().strftime('%Y-%m-%d')
        session = get_baostock_session()
        session.ensure_logged_in()
        try:
            rs = bs.query_adjust_factor(code=code, start_date=start_date, end_date=end_date)
        except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
            session.login(force=True)
            rs = bs.query_adjust_factor(code=code, start_date=start_date, end_date=end_date)
        if rs.error_code != '0':
            logger.warning(f"下载 {code} 复权因子失败: {rs.error_msg}")
            return None
        df = rs.get_data()
        if df.empty:
            return None
        df['dividOperateDate'] = pd.to_datetime(df['dividOperateDate'])
        if 'backAdjustFactor' in df.columns:
            df['backAdjustFactor'] = pd.to_numeric(df['backAdjustFactor'], errors='coerce')
        return df.sort_values('dividOperateDate').reset_index(drop=True)

    def save_raw_daily(self, code, df):
        safe = code.replace('.', '_')
        file_path = os.path.join(self.raw_daily_path, f"{safe}.parquet")
        df['trade_date'] = pd.to_datetime(df['trade_date'])
        if os.path.exists(file_path):
            existing = pd.read_parquet(file_path)
            existing['trade_date'] = pd.to_datetime(existing['trade_date'])
            combined = pd.concat([existing, df], ignore_index=True)
            combined = combined.drop_duplicates(subset=['trade_date'], keep='last')
            df = combined.sort_values('trade_date').reset_index(drop=True)
        df.to_parquet(file_path, index=False, compression='snappy')
        min_date = df['trade_date'].min().strftime('%Y%m%d')
        max_date = df['trade_date'].max().strftime('%Y%m%d')
        self._update_range_cache(code, min_date, max_date)

    def save_back_adjust(self, code, df):
        safe = code.replace('.', '_')
        file_path = os.path.join(self.back_adjust_path, f"{safe}_back_adjust.parquet")
        df['dividOperateDate'] = pd.to_datetime(df['dividOperateDate'])
        if os.path.exists(file_path):
            existing = pd.read_parquet(file_path)
            existing['dividOperateDate'] = pd.to_datetime(existing['dividOperateDate'])
            combined = pd.concat([existing, df], ignore_index=True)
            combined = combined.drop_duplicates(subset=['dividOperateDate'], keep='last')
            df = combined.sort_values('dividOperateDate').reset_index(drop=True)
        df.to_parquet(file_path, index=False, compression='snappy')

    def update_all_raw_daily(self, target_end_date=None, target_start_date=None):
        if target_end_date is None:
            target_end_date = datetime.now().strftime('%Y-%m-%d')
        elif len(target_end_date) == 8:
            target_end_date = f"{target_end_date[:4]}-{target_end_date[4:6]}-{target_end_date[6:]}"

        user_specified_start = target_start_date is not None
        if user_specified_start:
            if len(target_start_date) == 8:
                target_start_date = f"{target_start_date[:4]}-{target_start_date[4:6]}-{target_start_date[6:]}"
            target_start_dt = datetime.strptime(target_start_date, '%Y-%m-%d')

        logger.info("=" * 60)
        if user_specified_start:
            logger.info(f"开始增量更新原始日线，目标区间: {target_start_date} ~ {target_end_date}")
            logger.info("智能下载：自动补齐缓存未覆盖的头尾间隙")
        else:
            logger.info(f"开始增量更新原始日线，目标结束日期: {target_end_date}")
        logger.info("=" * 60)

        stock_df = self.download_stock_list()
        codes = stock_df['code'].tolist()
        total = len(codes)
        logger.info(f"共有 {total} 只股票需要检查")

        target_end_dt = datetime.strptime(target_end_date, '%Y-%m-%d')
        success_count = skip_count = fail_count = 0
        start_time = time.time()

        for i, code in enumerate(codes):
            cached_min, cached_max = self.get_stock_date_range(code)

            if user_specified_start:
                # --- 间隙补齐模式：自动补齐 [D1,D3) 和 (D4,D2] ---
                cached_min_dt = datetime.strptime(cached_min, '%Y%m%d') if cached_min else None
                cached_max_dt = datetime.strptime(cached_max, '%Y%m%d') if cached_max else None

                gaps = []  # list of (start_str, end_str)
                if cached_min_dt is None:
                    # 无缓存，整个区间都需要下载
                    gaps.append((target_start_date, target_end_date))
                else:
                    # 前段间隙: [target_start, min(cached_min-1, target_end)]
                    if cached_min_dt > target_start_dt:
                        head_end_dt = min(cached_min_dt - timedelta(days=1), target_end_dt)
                        if head_end_dt >= target_start_dt:
                            gaps.append((target_start_date, head_end_dt.strftime('%Y-%m-%d')))
                    # 后段间隙: [max(cached_max+1, target_start), target_end]
                    if cached_max_dt is not None and cached_max_dt < target_end_dt:
                        tail_start_dt = max(cached_max_dt + timedelta(days=1), target_start_dt)
                        if tail_start_dt <= target_end_dt:
                            gaps.append((tail_start_dt.strftime('%Y-%m-%d'), target_end_date))

                if not gaps:
                    skip_count += 1
                    if (i + 1) % 100 == 0:
                        elapsed = time.time() - start_time
                        avg_time = elapsed / (i + 1)
                        remaining = avg_time * (total - i - 1)
                        logger.info(
                            f"进度: {i + 1}/{total} "
                            f"(跳过: {skip_count}, 成功: {success_count}, 失败: {fail_count})，"
                            f"预计剩余: {remaining / 60:.1f} 分钟"
                        )
                    continue

                for gap_start, gap_end in gaps:
                    logger.info(f"[{i + 1}/{total}] {code} 补齐间隙: {gap_start} ~ {gap_end}")
                    df = self.download_raw_daily(code, gap_start, gap_end)
                    if df is not None and not df.empty:
                        self.save_raw_daily(code, df)
