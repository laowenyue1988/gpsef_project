    # ==================== 分红数据下载 ====================

    def download_dividend_data(self, code, start_year=2015, end_year=None):
        """下载单只股票的全部分红数据（按除权除息年份）。

        接口: baostock.query_dividend_data(code, year, yearType='operate')

        关键字段:
        - dividCashPsBeforeTax: 每股税前现金分红（元/股），可直接 float()
        - dividStocksPs: 每股送股比例（股/股），可直接 float()
        - dividReserveToStockPs: 每股转增比例（股/股），可直接 float()
        - dividCashPsAfterTax: 可能含"或"字，不使用
        - dividCashStock: 分红送转描述原文

        Returns:
            DataFrame 或 None
        """
        if end_year is None:
            end_year = datetime.now().year

        session = get_baostock_session()
        session.ensure_logged_in()

        all_rows = []
        fields = None
        for year in range(start_year, end_year + 1):
            for attempt in range(2):
                try:
                    rs = bs.query_dividend_data(
                        code=code, year=str(year), yearType="operate"
                    )
                    if rs.error_code == '0':
                        while rs.next():
                            row = rs.get_row_data()
                            if fields is None:
                                fields = rs.fields
                            all_rows.append(row)
                        break
                    else:
                        logger.debug(f"  {code} 年{year}分红查询返回: {rs.error_msg}")
                        break
                except (socket.timeout, OSError, ConnectionResetError, BrokenPipeError) as e:
                    session.report_error(f"socket: {e}")
                    time.sleep(1)
                except Exception as e:
                    logger.debug(f"  {code} 年{year}分红查询异常: {e}")
                    break
            time.sleep(0.02)

        if not all_rows or fields is None:
            return None

        df = pd.DataFrame(all_rows, columns=fields)

        keep_cols = [
            'dividOperateDate', 'dividRegistDate', 'dividPayDate',
            'dividCashPsBeforeTax', 'dividStocksPs',
            'dividReserveToStockPs', 'dividCashStock'
        ]
        available = [c for c in keep_cols if c in df.columns]
        df = df[available].copy()

        for col in ['dividCashPsBeforeTax', 'dividStocksPs', 'dividReserveToStockPs']:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0.0)

        df['dividOperateDate'] = pd.to_datetime(df['dividOperateDate'], errors='coerce')
        if 'dividRegistDate' in df.columns:
            df['dividRegistDate'] = pd.to_datetime(df['dividRegistDate'], errors='coerce')
        if 'dividPayDate' in df.columns:
            df['dividPayDate'] = pd.to_datetime(df['dividPayDate'], errors='coerce')

        df = df.dropna(subset=['dividOperateDate'])
        df = df.sort_values('dividOperateDate').reset_index(drop=True)
        session.update_activity()
        session.report_success()
        return df if not df.empty else None

    @staticmethod
    def _save_dividend_parquet(df, out_path, checked_year, checked_date=None):
        """保存分红缓存, 并把"已检查年度/检查日期"写入 parquet schema metadata。

        [2026-09-02 修复] 原实现只记 checked_year (年粒度) → 年内新分红事件
        (如 2026-06 检查后 2026-08 实施的新分红) 因 checked_year==end_year 被
        永久跳过。现追加 checked_date (检查执行截止日) 日期粒度:
          跳过条件 = checked_year>=end_year 且 checked_date>=end_date (update_all_dividend)。
        旧文件 (无 metadata) 由 _get_dividend_check 的 fallback 处理 (checked_date=None
        → 强制补查一次当年, 之后写入新 metadata)。
        """
        import pyarrow as pa
        import pyarrow.parquet as pq
        table = pa.Table.from_pandas(df)
        md = {**(table.schema.metadata or {}), b'divid_checked_year': str(checked_year)}
        if checked_date is not None:
            md[b'divid_checked_date'] = str(checked_date)
        table = table.replace_schema_metadata(md)
        pq.write_table(table, out_path, compression='snappy')

    @classmethod
    def _get_dividend_check(cls, out_path):
        """读取分红缓存检查状态 → (checked_year, checked_date)。

        checked_year: 数据已覆盖到的分红年度 (pyarrow metadata 'divid_checked_year')
        checked_date: 最近一次检查执行截止日期 (metadata 'divid_checked_date',
                      YYYYMMDD; 旧文件无此键 → None)
        文件不存在 → (None, None); 旧文件 fallback checked_year=数据最大分红年度,
        checked_date=None (→ 触发一次当年补查以捕获年内新增)。
        """
        if not os.path.exists(out_path):
            return None, None
        try:
            import pyarrow.parquet as pq
            md = pq.read_metadata(out_path).metadata
            if md:
                cy = md.get(b'divid_checked_year')
                cd = md.get(b'divid_checked_date')
                checked_year = int(cy) if cy is not None else None
                checked_date = None
                if cd is not None:
                    try:
                        checked_date = pd.Timestamp(str(cd.decode())).date()
                    except Exception:
                        checked_date = None
                if checked_year is not None:
                    return checked_year, checked_date
        except Exception:
            pass
        try:
            df = pd.read_parquet(out_path, columns=['dividOperateDate'])
            if df.empty:
                return None, None
            max_date = pd.to_datetime(df['dividOperateDate'], errors='coerce').max()
            if pd.isna(max_date):
                return None, None
            return int(max_date.year), None
        except Exception:
            return None, None

    @classmethod
    def _get_dividend_checked_year(cls, out_path):
        """[兼容保留] 只返回已检查年度 (旧调用语义)。"""
        cy, _ = cls._get_dividend_check(out_path)
        return cy

    def update_all_dividend(self, start_date=None, end_date=None):
        """批量下载全部分红数据到 data/dividend_data/。

        增量逻辑 (2026-09-02 修复, 替代 2026-08-17 年粒度版):
        - 读取缓存检查状态 (checked_year, checked_date), 见 _get_dividend_check
        - 跳过条件: checked_year >= end_year 且 checked_date >= end_date
          (原实现只有年粒度 checked_year>=end_year → 年内新分红事件
           (检查后当月/下月新实施) 被永久跳过 — 用户实证缺失)
        - 否则补查 [fetch_start_year, end_year] 年度并合并写回,
          同时写 metadata checked_year=end_year / checked_date=end_date
        - start_date/end_date 由 CLI --start/--end 传入 (原实现无参调用,
          CLI 日期被忽略 → 全部按 end_year=今年 跳过)；
          start_date=None 时年度起点用 2015 (全量历史), end_date=None 用今天。

        baostock query_dividend_data 为年度接口 (yearType=operate),
        故日期粒度在"年度重查 + 日期跳过标记"层面实现: 同一 end_year 内
        每次运行重查当年全年 (去重合并), 以捕获年内新增分红。
        """
        if end_date is None:
            end_date = datetime.now()
        if isinstance(end_date, str):
            end_date = pd.Timestamp(end_date)
        if hasattr(end_date, 'date') and not isinstance(end_date, pd.Timestamp):
            end_date = pd.Timestamp(end_date)
        end_year = end_date.year

        start_year = 2015
        if start_date is not None:
            if isinstance(start_date, str):
                start_date = pd.Timestamp(start_date)
            if hasattr(start_date, 'date') and not isinstance(start_date, pd.Timestamp):
                start_date = pd.Timestamp(start_date)
            start_year = start_date.year
        end_date_str = end_date.strftime('%Y%m%d')

        logger.info("=" * 60)
        logger.info(f"开始下载分红数据: {start_date or '2015-01-01'} ~ {end_date.date()} "
                    f"(年度 {start_year}~{end_year})")
        logger.info("=" * 60)

        stock_df = self.download_stock_list()
        codes = stock_df['code'].tolist()
        total = len(codes)

        success_count = skip_count = fail_count = empty_count = 0
        start_time = time.time()

        for i, code in enumerate(codes):
            safe = code.replace('.', '_')
            out_path = os.path.join(self.dividend_data_path, f"{safe}_dividend.parquet")

            checked_year, checked_date = self._get_dividend_check(out_path)
            # 跳过: 已覆盖目标年度 且 检查日期 >= 目标截止日 (日期粒度, 防年内新增遗漏)
            if (checked_year is not None and checked_year >= end_year
                    and checked_date is not None and checked_date >= end_date.date()):
                skip_count += 1
                if (i + 1) % 200 == 0:
                    logger.info(f"[{i+1}/{total}] 跳过已最新(至 {checked_date}): {skip_count}")
                continue

            try:
                # 补查年度起点:
                #  - 已检查到 end_year (但 checked_date < end_date, 年内新增场景) → 重查 end_year 当年
                #  - checked_year < end_year (含旧文件 fallback checked_date=None) → 从 checked_year+1 起补
                if checked_year is not None and checked_year >= end_year:
                    fetch_start = end_year
                else:
                    fetch_start = (checked_year + 1) if checked_year is not None else start_year
                    fetch_start = max(fetch_start, start_year)
                if fetch_start > end_year:
                    fetch_start = end_year
                df_new = self.download_dividend_data(code, fetch_start, end_year)
                if df_new is not None and not df_new.empty:
                    if checked_year is not None and os.path.exists(out_path):
                        # 与旧缓存合并 (按分红关键列去重)
                        df_old = pd.read_parquet(out_path)
                        df = pd.concat([df_old, df_new], ignore_index=True)
                        dedup_cols = [c for c in
                                      ['dividOperateDate', 'dividRegistDate', 'dividPayDate']
                                      if c in df.columns]
                        if dedup_cols:
                            df = df.drop_duplicates(subset=dedup_cols, keep='last')
                        df = df.sort_values('dividOperateDate').reset_index(drop=True)
                    else:
                        df = df_new
                    self._save_dividend_parquet(df, out_path, end_year, end_date_str)
                    success_count += 1
                else:
                    # 补查年度无新分红: 也写 metadata 标记已检查到 end_date, 避免反复重查
                    if checked_year is not None and os.path.exists(out_path):
                        df_old = pd.read_parquet(out_path)
                        self._save_dividend_parquet(df_old, out_path, end_year, end_date_str)
                    empty_count += 1
            except Exception as e:
                logger.warning(f"[{i+1}/{total}] {code} 分红数据下载失败: {e}")
                fail_count += 1

            if (i + 1) % 100 == 0:
                elapsed = time.time() - start_time
                avg = elapsed / (i + 1)
                remaining = avg * (total - i - 1)
                logger.info(
                    f"进度: {i+1}/{total} | 成功: {success_count} | "
                    f"跳过: {skip_count} | 无分红: {empty_count} | 失败: {fail_count} | "
                    f"剩余: {remaining/60:.1f}分钟"
                )
            time.sleep(0.05)

        elapsed = time.time() - start_time
        logger.info("=" * 60)
        logger.info(
            f"分红数据下载完成！总计: {total}，成功: {success_count}，"
            f"跳过(已有): {skip_count}，无分红: {empty_count}，失败: {fail_count}，"
            f"耗时: {elapsed/60:.1f}分钟"
        )
        logger.info("=" * 60)