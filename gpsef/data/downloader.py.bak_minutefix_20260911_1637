    # ==================== 日线中间缺口检测 (2026-09-01, 与分钟线同构) ====================

    def _find_daily_middle_gaps(self, code, start_dt, end_dt):
        """检测日线数据在 [start_dt, end_dt] 内的【中间缺口】。

        与分钟线 _find_minute_middle_gaps 语义一致: 缓存 min/max 覆盖区间, 但中间
        缺了某些交易日 (如磁盘写入中断/手工改动导致部分日期缺失)。原 update_all_raw_daily
        只算前段/后段间隙, 此类缺口永不补齐。

        注意: 日线下载是整段一次性拉取, 正常流程不会产生中间缺口; 本检测为防御性
        (历史坏文件/外部改动), 与分钟线共用 _get_trade_dates 交易日历。

        返回: [(gap_start_dt, gap_end_dt), ...] 连续缺口段 (datetime 对象, 闭区间)。
        """
        fpath = os.path.join(self.raw_daily_path, f"{code.replace('.', '_')}.parquet")
        if not os.path.exists(fpath):
            return []

        try:
            df = pd.read_parquet(fpath, columns=['trade_date'])
            have_days = set(pd.to_datetime(df['trade_date']).dt.date)
        except Exception as e:
            logger.debug(f"  [{code}] 读取日线文件失败, 跳过中间缺口检测: {e}")
            return []
        if not have_days:
            return []

        trade_days = self._get_trade_dates(start_dt, end_dt)
        if not trade_days:
            return []

        missing = sorted(d for d in trade_days if d not in have_days)
        if not missing:
            return []

        gaps = []
        seg_start = seg_end = missing[0]
        for d in missing[1:]:
            if (d - seg_end).days == 1:
                seg_end = d
            else:
                gaps.append((seg_start, seg_end))
                seg_start = seg_end = d
        gaps.append((seg_start, seg_end))

        logger.info(f"  [{code}] 日线中间缺口 {len(gaps)} 段: "
                    + ', '.join(f"{s}~{e}" for s, e in gaps))
        return [(datetime.combine(s, datetime.min.time()), datetime.combine(e, datetime.min.time()))
                for s, e in gaps]

    def update_all_raw_daily(self, target_end_date=None, target_start_date=None):
        if target_end_date is None:
            target_end_date = datetime.now().strftime('%Y-%m-%d')
        elif len(target_end_date) == 8:
            target_end_date = f"{target_end_date[:4]}-{target_end_date[4:6]}-{target_end_date[6:]}"

        user_specified_start = target_start_date is not None
        if user_specified_start:
            if len(target_start_date) == 8:
                target_start_date = f"{target_start_date[:4]}-{target_start_date[4:6]}-{target_start_date[6:]}"
            target_start_dt = datetime.strptime(target_start_date, '%Y-%m-%d')

        logger.info("=" * 60)
        if user_specified_start:
            logger.info(f"开始增量更新原始日线，目标区间: {target_start_date} ~ {target_end_date}")
            logger.info("智能下载：自动补齐缓存未覆盖的头尾间隙")
        else:
            logger.info(f"开始增量更新原始日线，目标结束日期: {target_end_date}")
        logger.info("=" * 60)

        stock_df = self.download_stock_list()
        codes = stock_df['code'].tolist()
        total = len(codes)
        logger.info(f"共有 {total} 只股票需要检查")

        target_end_dt = datetime.strptime(target_end_date, '%Y-%m-%d')
        success_count = skip_count = fail_count = 0
        start_time = time.time()

        for i, code in enumerate(codes):
            cached_min, cached_max = self.get_stock_date_range(code)

            if user_specified_start:
                # --- 间隙补齐模式：自动补齐 [D1,D3) 和 (D4,D2] ---
                cached_min_dt = datetime.strptime(cached_min, '%Y%m%d') if cached_min else None
                cached_max_dt = datetime.strptime(cached_max, '%Y%m%d') if cached_max else None

                gaps = []  # list of (start_str, end_str)
                if cached_min_dt is None:
                    # 无缓存，整个区间都需要下载
                    gaps.append((target_start_date, target_end_date))
                else:
                    # 前段间隙: [target_start, min(cached_min-1, target_end)]
                    if cached_min_dt > target_start_dt:
                        head_end_dt = min(cached_min_dt - timedelta(days=1), target_end_dt)
                        if head_end_dt >= target_start_dt:
                            gaps.append((target_start_date, head_end_dt.strftime('%Y-%m-%d')))
                    # 后段间隙: [max(cached_max+1, target_start), target_end]
                    if cached_max_dt is not None and cached_max_dt < target_end_dt:
                        tail_start_dt = max(cached_max_dt + timedelta(days=1), target_start_dt)
                        if tail_start_dt <= target_end_dt:
                            gaps.append((tail_start_dt.strftime('%Y-%m-%d'), target_end_date))
                    # [2026-09-01 防御性修复] 中间缺口: 缓存 min/max 覆盖区间, 但中间
                    #   缺了交易日 (历史坏文件/外部改动)。原逻辑只算前/后段间隙 → 永不补齐。
                    #   注: 日线整段下载正常流程不会产生中间缺口, 此处为防御性自愈。
                    try:
                        mid_gaps = self._find_daily_middle_gaps(code, target_start_dt, target_end_dt)
                        for mg_s, mg_e in mid_gaps:
                            gaps.append((mg_s.strftime('%Y-%m-%d'), mg_e.strftime('%Y-%m-%d')))
                    except Exception as e:
                        logger.warning(f"  [{code}] 日线中间缺口检测异常: {e}")

                # [2026-09-01] 前段/后段/中间缺口可能重叠, 合并去重后再下载
                if len(gaps) > 1:
                    gaps_dt = [(datetime.strptime(s, '%Y-%m-%d'), datetime.strptime(e, '%Y-%m-%d'))
                               for s, e in gaps]
                    gaps_dt = self._merge_gap_intervals(gaps_dt)
                    gaps = [(s.strftime('%Y-%m-%d'), e.strftime('%Y-%m-%d')) for s, e in gaps_dt]

                if not gaps:
                    skip_count += 1
                    if (i + 1) % 100 == 0:
                        elapsed = time.time() - start_time
                        avg_time = elapsed / (i + 1)
                        remaining = avg_time * (total - i - 1)
                        logger.info(
                            f"进度: {i + 1}/{total} "
                            f"(跳过: {skip_count}, 成功: {success_count}, 失败: {fail_count})，"
                            f"预计剩余: {remaining / 60:.1f} 分钟"
                        )
                    continue

                for gap_start, gap_end in gaps:
                    logger.info(f"[{i + 1}/{total}] {code} 补齐间隙: {gap_start} ~ {gap_end}")
                    df = self.download_raw_daily(code, gap_start, gap_end)
                    if df is not None and not df.empty:
                        self.save_raw_daily(code, df)
                        success_count += 1
                    else:
                        fail_count += 1
                        logger.warning(f"[{i + 1}/{total}] {code} 间隙 {gap_start}~{gap_end} 无数据或下载失败")
            else:
                # --- 原有逻辑：仅补尾部（保持不变） ---
                if cached_max is not None:
                    cached_max_dt = datetime.strptime(cached_max, '%Y%m%d')
                    if cached_max_dt >= target_end_dt:
                        skip_count += 1
                        if (i + 1) % 100 == 0:
                            elapsed = time.time() - start_time
                            avg_time = elapsed / (i + 1)
                            remaining = avg_time * (total - i - 1)
                            logger.info(
                                f"进度: {i + 1}/{total} "
                                f"(跳过: {skip_count}, 成功: {success_count}, 失败: {fail_count})，"
                                f"预计剩余: {remaining / 60:.1f} 分钟"
                            )
                        continue
                    start_fetch = (cached_max_dt + timedelta(days=1)).strftime('%Y-%m-%d')
                else:
                    start_fetch = '2026-05-08'
                    logger.info(f"[{i + 1}/{total}] {code} 新股票，从 {start_fetch} 开始下载")

                if start_fetch > target_end_date:
                    skip_count += 1
                    continue

                if (i + 1) % 10 == 0 or start_fetch != '2026-05-08':
                    logger.info(f"[{i + 1}/{total}] 正在处理 {code}，下载区间: {start_fetch} ~ {target_end_date}")

                df = self.download_raw_daily(code, start_fetch, target_end_date)
                if df is not None and not df.empty:
                    self.save_raw_daily(code, df)
                    success_count += 1
                else:
                    fail_count += 1
                    logger.warning(f"[{i + 1}/{total}] {code} 无新数据或下载失败")

            if (i + 1) % 100 == 0:
                elapsed = time.time() - start_time
                avg_time = elapsed / (i + 1)
                remaining = avg_time * (total - i - 1)
                logger.info(
                    f"进度: {i + 1}/{total} | 成功: {success_count} | "
                    f"跳过: {skip_count} | 失败: {fail_count} | "
                    f"预计剩余: {remaining / 60:.1f} 分钟"
                )
